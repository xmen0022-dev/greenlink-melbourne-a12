{
  "name": "greenlink-melbourne-a12",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "firebase:login": "firebase login",
    "firebase:emulators": "firebase emulators:start --only auth,firestore,functions,hosting",
    "firebase:deploy:functions": "firebase deploy --only functions",
    "firebase:deploy:hosting": "npm run build && firebase deploy --only hosting",
    "seed:emulator": "node scripts/seed-firestore.mjs",
    "seed:cloud": "node scripts/seed-firestore.mjs --cloud",
    "verify:cloud-catalog": "node scripts/verify-cloud-catalog.mjs",
    "verify:cloud-auth": "node scripts/verify-cloud-auth.mjs",
    "test:auth": "node tests/auth.integration.test.mjs",
    "test:firestore-rules": "node tests/firestore.rules.test.mjs",
    "test:geo": "node --test tests/geo.test.mjs",
    "test:functions": "firebase emulators:exec --only auth,firestore,functions \"npm run seed:emulator && node tests/functions.integration.test.mjs\""
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.3",
    "firebase": "^13.0.0",
    "leaflet": "^1.9.4",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "firebase-tools": "^15.34.0",
    "vite": "^8.2.2"
  }
}
